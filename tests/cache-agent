#!/usr/bin/env bash
# Filesystem stand-in for Cache; Git itself is never mocked.
set -euo pipefail
[[ "$1" == cache && "$3" == --cache-config-file && "$5" == --cache-fail-on-error && "$6" == --no-color ]]
config="$(cat "$4")"
case "$config" in
  *'name: git_snapshot_patch'*)
    # Exact keys only: a patch for another snapshot or commit is never returned.
    [[ "$config" == *'      - patch'* && "$config" != *fallback_limit* ]]
    kind=patch target=patch
    key="$GIT_SNAPSHOT_BASE-$GIT_SNAPSHOT_TARGET"
    ;;
  *)
    [[ "$config" == *'fallback_limit: true'* && "$config" == *'      - .git'* ]]
    kind=snapshot target=.git
    key="$GIT_SNAPSHOT_PERIOD"
    ;;
esac
namespace="$(printf '%s\n%s\n%s' "$GIT_SNAPSHOT_PREFIX" "$GIT_SNAPSHOT_REPO" "$kind" | git hash-object --stdin)"
store="$TEST_CACHE/$kind/$namespace"
mkdir -p "$store"
entry="$store/$key"
echo "$2 $kind $key" >> "$TEST_CACHE/operations"
case "$2" in
  restore)
    [[ "${TEST_RESTORE_ERROR:-false}" == false ]] || { mkdir "$target"; exit 1; }
    if [[ ! -d "$entry" && "$kind" == snapshot ]]; then
      entry="$(find "$store" -mindepth 1 -maxdepth 1 -type d | sort -t / -k 999n | tail -1)"
    fi
    [[ -n "$entry" && -d "$entry" ]] || exit 0
    cp -a "$entry/$target" "$target"
    ;;
  save)
    [[ "${TEST_SAVE_ERROR:-false}" == false ]] || exit 1
    [[ -d "$entry" ]] && exit 0
    mkdir "$entry"
    cp -a "$target" "$entry/$target"
    ;;
  *) exit 1 ;;
esac
